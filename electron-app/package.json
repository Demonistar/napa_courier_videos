{
  "name": "napa-courier-admin",
  "version": "1.0.16",
  "description": "NAPA Courier Admin — Desktop location management tool",
  "main": "out/main/main.js",
  "author": "NAPA Courier",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --config electron-builder.config.js",
    "version:bump-local": "npm version patch --no-git-tag-version",
    "package:win": "npm run version:bump-local && npm run build && electron-builder --win --config electron-builder.config.js",
    "package:mac": "npm run version:bump-local && npm run build && electron-builder --mac --config electron-builder.config.js",
    "publish:win": "npm run build && electron-builder --win --publish always --config electron-builder.config.js",
    "publish:mac": "npm run build && electron-builder --mac --publish always --config electron-builder.config.js",
    "package:linux": "npm run version:bump-local && npm run build && electron-builder --linux --config electron-builder.config.js",
    "publish:linux": "npm run build && electron-builder --linux --publish always --config electron-builder.config.js",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "package:dir": "npm run build && electron-builder --dir --config electron-builder.config.js",
    "package:dir:win": "npm run build && electron-builder --win --dir --config electron-builder.config.js",
    "package:dir:mac": "npm run build && electron-builder --mac --dir --config electron-builder.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.3.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-resizable-panels": "^2.1.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.10"
  }
}
