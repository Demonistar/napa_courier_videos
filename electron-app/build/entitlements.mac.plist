<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for hardened runtime: allows the app to run JIT-compiled code (V8/Chromium) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allows unsigned executable memory (needed by Electron/Chromium internals) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allows loading dylibs that aren't signed with the same certificate -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access for Dropbox API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
