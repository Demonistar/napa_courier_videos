# Copy this file to .env and fill in your values before building.

# ── Dropbox OAuth App Key ───────────────────────────────────────────────────
# 1. Go to https://www.dropbox.com/developers/apps
# 2. Click "Create app"
# 3. Choose: "Scoped access" → "Full Dropbox"
# 4. Name your app (e.g. "NAPA Courier Admin")
# 5. Under "OAuth 2 → Redirect URIs", add: http://localhost:47291/callback
#    (and also add a few others like http://localhost:47292/callback to http://localhost:47299/callback
#     in case port 47291 is in use — the app will try these ports in order)
# 6. Under "Permissions", enable:
#      files.content.read, files.content.write, account_info.read
# 7. Copy the "App key" below (NOT the App secret — PKCE flow doesn't use it)

DROPBOX_APP_KEY=YOUR_APP_KEY_HERE

# ── Default Dropbox folder path ─────────────────────────────────────────────
# Path inside Dropbox where the app stores its data files.
# Must be an absolute Dropbox path starting with /.
# All five admins must point to the SAME shared folder.
# This can also be changed per-machine in Settings after first run.

DROPBOX_FOLDER_PATH=/NAPA Courier Admin
